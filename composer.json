{
    "name": "rushing/laravel-request-logs",
    "description": "Inbound and outbound HTTP request logging for Laravel — correlation IDs, per-channel redaction pipelines, model-tracking, and prunable lightweight database references.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-package-tools": "^1.16",
        "rushing/laravel-schema-convergence": "*"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Required only to log outbound HTTP calls via GuzzleRequestLogMiddleware (^7.0)."
    },
    "autoload": {
        "psr-4": {
            "Rushing\\RequestLogs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rushing\\RequestLogs\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Rushing\\RequestLogs\\RequestLogsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/pest",
        "pint": "@php vendor/bin/pint"
    }
}
